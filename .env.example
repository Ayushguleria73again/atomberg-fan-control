# Copy to .env.local and fill in. NEVER commit .env.local.

# ============================================================
# MULTI-TENANT PRODUCT (docs/13, docs/14) — the public build
# ============================================================
# Database (provision via Vercel Marketplace — Neon Postgres)
DATABASE_URL=

# Master key for encrypting each user's Atomberg creds at rest (AES-256-GCM).
# Generate: openssl rand -base64 32   — 32 bytes. NEVER commit or log. Not in the DB.
CREDENTIAL_ENCRYPTION_KEY=

# Auth (Clerk shown; or Auth.js equivalents). Provision via Vercel Marketplace.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Per-user cache / rate limiting (Upstash Redis via Vercel Marketplace)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# SINGLE-TENANT / PERSONAL build only (docs/02) — remove for the public product,
# since credentials there come per-user from the encrypted DB instead.
# ============================================================
# ATOMBERG_API_KEY=
# ATOMBERG_REFRESH_TOKEN=
# APP_PASSCODE=

# ============================================================
# Phase 6 voice fallback (optional; on-device Whisper needs no key)
# ============================================================
# GROQ_API_KEY=

# ============================================================
# Future upgrade only (NOT used): Home Assistant hub
# ============================================================
# HA_BASE_URL=
# HA_TOKEN=
