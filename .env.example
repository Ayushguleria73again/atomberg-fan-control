# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Atomberg Cloud (v1: direct-to-Atomberg — REQUIRED) ---
# From the Atomberg Home app → Developer Options
ATOMBERG_API_KEY=
ATOMBERG_REFRESH_TOKEN=

# --- Optional: cross-invocation cache (Upstash Redis via Vercel Marketplace) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional: app access control ---
# APP_PASSCODE=

# --- Phase 6: high-end voice STT (server-side; only if using cloud transcription) ---
# GROQ_API_KEY=
# DEEPGRAM_API_KEY=

# --- Future upgrade only (NOT used in v1): Home Assistant hub ---
# HA_BASE_URL=
# HA_TOKEN=
